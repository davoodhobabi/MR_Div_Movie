{
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/subtitles.js": { "maxDuration": 60 },
    "api/media-range.js": { "maxDuration": 30 },
    "api/media-resolve.js": { "maxDuration": 30 },
    "api/folder-listing.js": { "maxDuration": 30 },
    "api/episodes.js": { "maxDuration": 30 },
    "api/poster-image.js": { "maxDuration": 20 }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
